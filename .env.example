# Postgres. Local: the Docker container from docker-compose.yml (port 5436).
DATABASE_URL="postgresql://glitz:glitz@localhost:5436/glitz"

# Public origin, used in emails and share links.
SITE_URL="http://localhost:3020"

# The events desk's WhatsApp number, international format, digits only (e.g. 2348012345678).
# Booking confirmations offer a one-tap WhatsApp message to this number.
WHATSAPP_NUMBER="2348000000000"

# Email via Resend (https://resend.com). Leave RESEND_API_KEY empty to log emails to the console.
RESEND_API_KEY=""
EMAIL_FROM="Glitz & Style <desk@example.com>"
# Where new booking alerts go (comma-separate several addresses).
NOTIFY_EMAIL="events@example.com"
