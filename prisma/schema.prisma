generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum Section {
  EVENTS
  WEDDINGS
  RED_CARPET
  STYLE
  BEAUTY
  LIFESTYLE
}

enum StoryStatus {
  DRAFT
  PUBLISHED
}

enum EventKind {
  WEDDING
  OWAMBE
  GALA
  LAUNCH
  CONCERT
}

enum BookingStatus {
  NEW
  CONTACTED
  CONFIRMED
  DECLINED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         Role      @default(EDITOR)
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  stories      Story[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Image {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  width     Int
  height    Int
  createdAt DateTime @default(now())
}

model Story {
  id           String      @id @default(cuid())
  slug         String      @unique
  title        String
  dek          String
  body         String
  section      Section
  byline       String
  photoCredit  String      @default("")
  coverImageId String?
  status       StoryStatus @default(DRAFT)
  featured     Boolean     @default(false)
  publishedAt  DateTime?
  authorId     String?
  author       User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, publishedAt])
}

model Event {
  id        String    @id @default(cuid())
  title     String
  city      String
  venue     String
  startsAt  DateTime
  kind      EventKind
  dressCode String
  colorA    String    @default("#C8102E")
  colorB    String    @default("#E9CFAF")
  published Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Look {
  id           String   @id @default(cuid())
  name         String
  description  String
  coverImageId String?
  hits         Int      @default(0)
  misses       Int      @default(0)
  active       Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
}

model Booking {
  id         String        @id @default(cuid())
  ref        String        @unique
  name       String
  phone      String
  email      String?
  kind       EventKind
  city       String
  eventDate  DateTime
  hours      Int
  addons     String[]
  notes      String        @default("")
  totalNaira Int
  tier       String
  status     BookingStatus @default(NEW)
  createdAt  DateTime      @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
